{
  "name": "parivartan-workspace",
  "version": "1.0.0",
  "description": "Workspace launcher for the Parivartan backend, portal, and mobile apps",
  "scripts": {
    "start": "npm start --prefix backend",
    "dev": "npm run dev --prefix backend",
    "backend": "npm start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "client": "npm run dev --prefix portal",
    "portal:start": "npm start --prefix portal",
    "portal:dev": "npm run dev --prefix portal",
    "portal:build": "npm run build --prefix portal",
    "portal:test": "npm test --prefix portal -- --watchAll=false",
    "portal:eject": "npm run eject --prefix portal",
    "install:all": "npm install --prefix backend && npm install --prefix portal"
  }
}

# Pathway service environment variables
# Copy this file to .env and fill in your values.

# Port for the Pathway REST input connector (accepts POST /  with issue JSON)
PATHWAY_PORT=8080

# Port for the SSE output endpoint (GET /stream)
PATHWAY_SSE_PORT=8081

# Absolute or relative path to your Firebase service-account credentials JSON.
# Relative paths are resolved from the pathway-service/ directory.
# Default: ../backend/config/serviceAccountKey.json  (the backend credentials)
FIREBASE_CREDENTIALS=../backend/config/serviceAccountKey.json

# Set this in the Express backend .env so it forwards new issues to Pathway:
# PATHWAY_SERVICE_URL=http://localhost:8080/
